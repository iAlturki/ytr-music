#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "app.ico"
IDR_WEBVIEW2_LOADER RCDATA "../sdk/x64/WebView2Loader.dll"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "iALTURKi"
            VALUE "FileDescription", "ytr-music (iALTURKi Edition)"
            VALUE "FileVersion", "4.0.0.0"
            VALUE "InternalName", "ytr-music"
            VALUE "LegalCopyright", "Copyright (C) 2026 iALTURKi. All rights reserved."
            VALUE "OriginalFilename", "ytr-music.exe"
            VALUE "ProductName", "ytr-music"
            VALUE "ProductVersion", "4.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Enable Windows Modern Visual Styles and Per-Monitor DPI Awareness
1 24 "app.manifest"
